---
// src/components/Navbar.astro
import ThemeSelector from './ThemeSelector.astro';
import MobileMenu from './MobileMenu.astro';
import { navLinks } from '../data/navLinks.js';
---

<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300" id="main-header">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-4">
    <nav class="flex items-center justify-between px-4 md:px-6 py-3 rounded-2xl bg-base-light/80 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/20">
      <!-- Logo / Nombre limpio -->
      <a href="#inicio" class="text-base md:text-lg font-extrabold text-text-strong tracking-tight hover-accent transition-colors">
        Andrew <span class="text-accent">Licona</span>
      </a>

      <!-- Navegación Desktop -->
      <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="px-3.5 py-2 rounded-xl text-text-muted hover:text-text-strong hover:bg-white/5 transition-all duration-200"
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <!-- Controles Desktop y Mobile -->
      <div class="flex items-center gap-2 md:gap-3">
        <ThemeSelector />
        <MobileMenu />
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('py-2');
    } else {
      header?.classList.remove('py-2');
    }
  });
</script>
