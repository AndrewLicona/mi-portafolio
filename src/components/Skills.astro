---
import { skills } from "../data/skills.js";
---

<section id="habilidades" class="min-h-screen h-screen flex flex-col justify-center px-4 md:px-6 relative overflow-hidden snap-start bg-gradient-mesh pt-24 md:pt-16">
  <div class="max-w-5xl mx-auto w-full py-4 overflow-y-auto max-h-[85vh] scrollbar-hide">
    <div class="text-center mb-6 md:mb-8">
      <h2 class="text-2xl md:text-5xl font-extrabold mb-2 text-accent tracking-tight">Habilidades</h2>
      <p class="text-text-muted max-w-xl mx-auto text-xs md:text-base">
        Tecnologías, lenguajes y herramientas con las que construyo mis proyectos
      </p>
    </div>

    <div class="space-y-6 md:space-y-8 pb-10">
      <!-- Lenguajes -->
      <div class="card p-5 md:p-8 bg-base-light/70 backdrop-blur-xl border border-white/10 shadow-2xl rounded-2xl">
        <h3 class="text-lg md:text-xl font-bold mb-4 text-text-strong flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
          Lenguajes
        </h3>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3 md:gap-6 justify-items-center">
          {skills.languages.map(skill => (
            <div class="flex flex-col items-center justify-center gap-2 p-3 rounded-xl bg-base-dark/40 border border-white/5 hover:border-accent/40 transition-all duration-300 group w-full">
              <img
                src={skill.imageUrl}
                alt={`Logo de ${skill.name}`}
                width="40"
                height="40"
                class="w-10 h-10 md:w-12 md:h-12 object-contain group-hover:scale-110 transition-transform duration-300"
                loading="lazy"
              />
              <span class="text-[11px] md:text-xs font-semibold text-text-muted group-hover:text-text-strong transition-colors">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Herramientas -->
      <div class="card p-5 md:p-8 bg-base-light/70 backdrop-blur-xl border border-white/10 shadow-2xl rounded-2xl">
        <h3 class="text-lg md:text-xl font-bold mb-4 text-text-strong flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
          Herramientas & Tecnologías
        </h3>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3 md:gap-4 justify-items-center">
          {skills.tools.map(skill => (
            <div class="flex flex-col items-center justify-center gap-2 p-2.5 md:p-3 rounded-xl bg-base-dark/40 border border-white/5 hover:border-accent/40 transition-all duration-300 group w-full">
              <img
                src={skill.imageUrl}
                alt={`Logo de ${skill.name}`}
                width="36"
                height="36"
                class="w-9 h-9 md:w-10 md:h-10 object-contain group-hover:scale-110 transition-transform duration-300"
                loading="lazy"
              />
              <span class="text-[10px] md:text-xs font-semibold text-text-muted group-hover:text-text-strong transition-colors text-center truncate w-full">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
