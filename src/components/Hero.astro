---
import Icon from "./Icon.astro";
import { redes } from "../data/redes.js";
---

<section
  id="inicio"
  class="bg-gradient-mesh min-h-screen h-screen flex flex-col justify-center items-center text-center px-4 md:px-6 relative overflow-hidden snap-start pt-20"
>
  <div class="fade-in max-w-4xl mx-auto z-10">
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 text-text-strong tracking-tight leading-tight">
      Hola, soy <br class="sm:hidden" /><span class="text-accent">Andrew Licona</span>
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-text-muted max-w-2xl mx-auto mb-8 leading-relaxed px-2">
      Ingeniero de Software y Administrador de Infraestructura. Construyo soluciones web robustas, escalables y de alto rendimiento.
    </p>

    <div class="flex flex-wrap gap-3 sm:gap-4 justify-center items-center">
      <a href="#proyectos" class="btn btn-primary shadow-xl text-sm sm:text-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        Ver Proyectos
      </a>
      <a href="#contacto" class="btn btn-outline text-sm sm:text-base">
        Contáctame
      </a>
      {
        redes.map((red) => (
          <a
            href={red.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline p-3 rounded-full"
            aria-label={red.name}
          >
            <Icon name={red.icon} class="w-5 h-5" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#sobre-mi"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-text-muted hover:text-accent transition-colors z-10"
    aria-label="Ir a sobre mí"
  >
    <span class="text-[11px] font-medium tracking-wider uppercase">Explorar</span>
    <svg class="w-4 h-4 animate-bounce text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>
</section>
