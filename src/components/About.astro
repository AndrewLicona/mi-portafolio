---
// src/components/About.astro
import { Image } from "astro:assets";
import profileImg from "../assets/fp1.png";
---

<section
  id="sobre-mi"
  class="min-h-screen h-screen flex flex-col justify-center items-center px-4 md:px-8 relative overflow-hidden snap-start bg-gradient-linear pt-20"
>
  <div class="max-w-4xl mx-auto w-full">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl md:text-4xl font-extrabold mb-2 text-accent tracking-tight">
        Sobre mí
      </h2>
      <p class="text-text-muted max-w-lg mx-auto text-xs md:text-sm">
        Conoce un poco más sobre mi trayectoria, pasión y enfoque profesional
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center card p-6 md:p-10 bg-base-light/70 backdrop-blur-xl border border-white/10 shadow-2xl">
      <!-- Columna de la imagen (más compacta en mobile) -->
      <div class="md:col-span-4 flex justify-center">
        <div class="relative group">
          <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-accent via-purple-500 to-blue-500 opacity-80 blur-lg group-hover:opacity-100 transition duration-700 animate-pulse"></div>
          <div class="relative w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-2xl overflow-hidden border-2 border-accent/50 shadow-2xl bg-base-dark">
            <Image
              src={profileImg}
              alt="Foto de Andrew Licona"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={192}
              height={192}
              format="webp"
              quality={90}
            />
          </div>
        </div>
      </div>

      <!-- Columna del texto -->
      <div class="md:col-span-8 space-y-3 md:space-y-4 text-left">
        <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-text-strong">
          Ingeniero de Software & Administrador de Infraestructura
        </h3>
        <p class="text-text-base text-xs sm:text-sm md:text-base leading-relaxed">
          Soy <span class="font-semibold text-accent">Andrew Licona</span>, un apasionado por la tecnología con experiencia en desarrollo full-stack, automatización y despliegue de servicios en servidores caseros utilizando contenedores y redes seguras.
        </p>
        <p class="text-text-muted text-xs sm:text-sm md:text-base leading-relaxed hidden sm:block">
          Me enfoca crear herramientas eficientes, escalables y con un diseño impecable. Creo firmemente que la combinación de un buen código backend con interfaces modernas es la clave para experiencias digitales memorables.
        </p>

        <div class="flex flex-wrap gap-2 pt-1">
          <span class="px-2.5 py-1 text-[11px] font-medium rounded-lg bg-accent/10 text-accent border border-accent/20">Clean Code</span>
          <span class="px-2.5 py-1 text-[11px] font-medium rounded-lg bg-accent/10 text-accent border border-accent/20">DevOps & Homelab</span>
          <span class="px-2.5 py-1 text-[11px] font-medium rounded-lg bg-accent/10 text-accent border border-accent/20">Full-Stack Web</span>
        </div>
      </div>
    </div>
  </div>
</section>
